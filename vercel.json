{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/physics-lab",
      "destination": "/experiments",
      "permanent": true
    },
    {
      "source": "/physics-lab/:path*",
      "destination": "/experiments",
      "permanent": true
    }
  ]
}
