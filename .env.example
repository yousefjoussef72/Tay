# Public Supabase project URL
VITE_SUPABASE_URL=

# Supabase publishable key (safe for browser when RLS is enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Groq API key for free-tier research generation. Never prefix with VITE_.
GROQ_API_KEY=

# Optional: free-tier model default is openai/gpt-oss-120b.
# GROQ_RESEARCH_MODEL=openai/gpt-oss-120b
