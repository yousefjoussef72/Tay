# Public Supabase project URL
VITE_SUPABASE_URL=

# Supabase publishable key (safe for browser when RLS is enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Groq API key shared by all AI features. Never prefix with VITE_.
GROQ_API_KEY=

# Shared model for research, activities, question generation, and essay grading.
GROQ_MODEL=openai/gpt-oss-120b

# Legacy fallback for existing deployments; prefer GROQ_MODEL.
# GROQ_RESEARCH_MODEL=openai/gpt-oss-120b
